{
  "name": "ultimate-member/wall-lib",
  "description": "UM discussion wall for Ultimate Member extensions.",
  "license": "MIT",
  "keywords": ["wordpress", "ultimate member"],
  "type": "library",
  "authors": [
    {
      "name": "Ultimate Member",
      "email": "support@ultimatemember.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "wp-cli/wp-cli": "^2.12",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "3.4.*",
    "squizlabs/php_codesniffer": "^3.13.5"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
